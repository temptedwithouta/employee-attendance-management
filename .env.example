# Local development only; replace values and never commit real secrets.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=dexa_wfh
MYSQL_USER=dexa
MYSQL_PASSWORD=change_me
APP_DB_USER=dexa_app
APP_DB_PASSWORD=change_me_runtime
DATABASE_URL=mysql://dexa:change_me@localhost:3306/dexa_wfh
APP_DATABASE_URL=mysql://dexa_app:change_me_runtime@localhost:3306/dexa_wfh
API_PORT=3000
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters
JWT_EXPIRES_IN=1h
SEED_HR_EMAIL=replace_hr@example.com
SEED_HR_PASSWORD=replace_with_hr_password
SEED_EMPLOYEE_EMAIL=replace_employee@example.com
SEED_EMPLOYEE_PASSWORD=replace_with_employee_password
