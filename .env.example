WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3000/api/v1
# Attendance photos: 1-5 MiB; relative directory is resolved from apps/api.
UPLOAD_MAX_SIZE_MB=5
UPLOAD_DIR=./uploads
